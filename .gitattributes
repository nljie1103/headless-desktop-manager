# Keep Linux shell scripts executable and readable on Linux after Windows uploads.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.tsv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
